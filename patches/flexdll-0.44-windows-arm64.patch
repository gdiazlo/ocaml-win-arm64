+            (Char.chr (Int32.to_int (Int32.logand (Int32.shift_right_logical insn (8 * i)) 0xffl)))
+        done;
+        { rel with symbol = sym }
+      end) sec.relocs) obj.sections;
+  if Buffer.length data <> 0 then begin
+    sect.data <- `String (Buffer.to_bytes data);
