diff --git a/runtime/win32.c b/runtime/win32.c
index 16e257e..2ec1640 100644
--- a/runtime/win32.c
+++ b/runtime/win32.c
@@ -567,6 +567,27 @@ static LONG CALLBACK
   return EXCEPTION_CONTINUE_SEARCH;
 }
 
+#elif defined(__aarch64__)
+
+static LONG CALLBACK
+    caml_stack_overflow_VEH (EXCEPTION_POINTERS* exn_info)
+{
+  DWORD code = exn_info->ExceptionRecord->ExceptionCode;
+  CONTEXT *ctx = exn_info->ContextRecord;
+
+  if (code == EXCEPTION_STACK_OVERFLOW &&
+      caml_find_code_fragment_by_pc((char *) ctx->Pc) != NULL) {
+    uintnat *alt_sp = win32_alt_stack +
+      sizeof(win32_alt_stack) / sizeof(uintnat);
+    Caml_state->young_ptr = (value *) ctx->X27;
+    ctx->X0 = exn_info->ExceptionRecord->ExceptionInformation[1];
+    ctx->Sp = (uintnat) alt_sp & ~(uintnat) 15;
+    ctx->Pc = (uintnat) &caml_reset_stack;
+    return EXCEPTION_CONTINUE_EXECUTION;
+  }
+  return EXCEPTION_CONTINUE_SEARCH;
+}
+
 #else
 
 static LONG CALLBACK
