-                           + (double) optval.tv.tv_usec / USEC_PER_SEC);
+    res = caml_copy_double((double) optval.milliseconds / 1000.0);
     break;
   case TYPE_UNIX_ERROR:
     if (optval.i == 0) {
@@ -188,10 +187,17 @@ CAMLexport value caml_unix_setsockopt_aux(const char * name,
     if (optval.lg.l_onoff)
