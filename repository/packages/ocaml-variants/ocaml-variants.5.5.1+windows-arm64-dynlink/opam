opam-version: "2.0"
synopsis: "OCaml 5.5.1: native Windows ARM64 with FlexDLL (Clang/UCRT)"
description: """
Experimental Windows ARM64 compiler with dynamic C-stub loading and native
Dynlink. Bootstraps the bundled ARM64 FlexDLL sources with OCaml's shipped
bytecode, without requiring an installed compiler or FlexDLL.
Requires the project's MSYS2 CLANGARM64 toolchain in PATH. Keep this variant
separate from the original static switch; rebuild precompiled native libraries.
"""
maintainer: "Windows ARM64 port project"
authors: ["OCaml contributors" "FlexDLL contributors" "Windows ARM64 port project"]
license: ["LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception" "Zlib" "BSD-3-Clause"]
homepage: "https://ocaml.org"
dev-repo: "git+https://github.com/ocaml/ocaml.git#5.5.1"
bug-reports: "https://github.com/ocaml/ocaml/issues"
flags: compiler
conflict-class: "ocaml-core-compiler"
available: os = "win32" & arch = "arm64"
depends: [
  "ocaml" {= "5.5.1" & post}
  "base-unix" {post}
  "base-bigarray" {post}
  "base-threads" {post}
  "base-domains" {post}
  "base-nnp" {post}
  "base-effects" {post}
]
build-env: [
  [MSYS2_ARG_CONV_EXCL = "*"]
  [CAML_LD_LIBRARY_PATH = ""]
  [FLEXDIR = ""]
]
build: [
  ["sh" "configure"
    "--build=aarch64-w64-mingw32" "--host=aarch64-w64-mingw32"
    "--prefix=%{prefix}%" "--enable-shared" "--with-flexdll=flexdll"
    "--disable-dependency-generation" "--with-relative-libdir"
    "--with-additional-stublibsdir" "--enable-runtime-search"
    "--enable-runtime-search-target=fallback"
    "CC=clang" "AR=llvm-ar" "RANLIB=llvm-ranlib" "RC=windres"]
  [make "-j2"]
]
install: [
  [make "install"]
  ["bash" "-c" "cp \"$(pkgconf --variable=prefix libzstd)/bin/libzstd.dll\" \"%{bin}%/\""]
  ["mkdir" "-p" "%{doc}%"]
  ["bash" "-c" "cp \"$(pkgconf --variable=prefix libzstd)/share/licenses/zstd/LICENSE\" \"%{doc}%/zstd-LICENSE\""]
]
url {
  src: "C:/ocaml-dev/dist/ocaml-5.5.1-windows-arm64-dynlink-src.tar.gz"
  checksum: "sha256=7f7dbc6577e5d7ff2dd30b011b7261d2406317f67df3f83f2bc0a1dda8405746"
}
post-messages: [
  "Experimental native ARM64 compiler with dynamic C stubs and native Dynlink installed. Do not mix native libraries from the original static variant." {!failure}
]
